{
  "name": "music-analyser",
  "version": "0.3.1",
  "author": "Pat Carroll",
  "description": "A spectrogram annotation platform for close listening, music education and precise feedback on recordings.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "test": "node --test tests/*.test.cjs",
    "sync:legal": "node scripts/sync-legal-docs.cjs",
    "test:integration": "electron scripts/test-renderer.cjs"
  },
  "build": {
    "appId": "com.patrickcarroll.music-analyser",
    "productName": "HearPlot",
    "files": [
      "index.html",
      "styles.css",
      "loudness.js",
      "tempo.js",
      "spectrogram.js",
      "metronome.js",
      "session.js",
      "storage.js",
      "app.js",
      "legal-content.js",
      "main.cjs",
      "preload.cjs",
      "assets/**/*",
      "metadata.cjs",
      "analysis-client.js",
      "analysis-worker.js",
      "analysis-core.js",
      "audio-decode.js",
      "mix-analysis.js",
      "mix-lab.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/app-icon.icns"
    }
  },
  "devDependencies": {
    "electron": "^43.8.10",
    "electron-builder": "^26.18.1"
  }
}
